{
  "ConnectionStrings": {
    "PulseRisk": "Host=localhost;Port=5432;Database=pulserisk;Username=pulserisk;Password=pulserisk"
  },
  "EventChannels": {
    "DefaultCapacity": 1024,
    "DefaultFullMode": "Wait",
    "QuoteCapacity": 4096,
    "QuoteFullMode": "DropOldest",
    "RiskCapacity": 1024,
    "RiskFullMode": "Wait"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
